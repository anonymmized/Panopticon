  "semanticColors": {
    "dark": {
      "textPrimary": "#F5F7FA",
      "textSecondary": "#B8C0CC",
      "textMuted": "#8590A2",
      "surfaceCard": "rgba(255, 255, 255, 0.07)",
      "surfaceCardHover": "rgba(255, 255, 255, 0.11)",
      "surfaceCardPressed": "rgba(255, 255, 255, 0.15)",
      "borderSubtle": "rgba(255, 255, 255, 0.10)",
      "borderFocus": "#58A6FF",
      "statusSuccess": "#3FB950",
      "statusWarning": "#E3B341",
      "statusDanger": "#F85149",
      "badgeNotificationBg": "#E53935",
      "badgeNotificationText": "#FFFFFF"
    },
    "light": {
      "textPrimary": "#11151C",
      "textSecondary": "#424A55",
      "textMuted": "#656D78",
      "surfaceCard": "rgba(0, 0, 0, 0.04)",
      "surfaceCardHover": "rgba(0, 0, 0, 0.07)",
      "surfaceCardPressed": "rgba(0, 0, 0, 0.10)",
      "borderSubtle": "rgba(0, 0, 0, 0.10)",
      "borderFocus": "#0969DA",
      "statusSuccess": "#1A7F37",
      "statusWarning": "#9A6700",
      "statusDanger": "#CF222E",
      "badgeNotificationBg": "#D32F2F",
      "badgeNotificationText": "#FFFFFF"
    }
  },
  "motion": {
    "hoverMagnification": {
      "response": 0.18,
      "dampingFraction": 0.78,
      "reduceMotion": "instantHighlightOnly"
    },
    "iconPress": {
      "scale": 0.92,
      "durationMs": 90,
      "reduceMotionScale": 0.98
    },
    "appLaunchBounce": {
      "heightPt": 12,
      "durationMs": 420,
      "reduceMotion": "opacityPulse200ms"
    },
    "spaceSwitch": {
      "durationMs": 140,
      "curve": "easeOutCubic",
      "reduceMotionDurationMs": 0
    },
    "autoHideShow": {
      "durationMs": 180,
      "curve": "easeOutQuart",
      "reduceMotionDurationMs": 80
    },
    "autoHideDismiss": {
      "durationMs": 220,
      "delayMs": 280,
      "curve": "easeInOutQuad",
      "reduceMotionDurationMs": 80
    },
    "popoverOpen": {
      "durationMs": 140,
      "scaleFrom": 0.96,
      "reduceMotionScaleFrom": 1.0
    }
  },
  "accessibilityOverrides": {
    "reduceMotion": {
      "disableMagnificationNeighborDisplacement": true,
      "disableLaunchBounce": true,
      "disableRunningTextMarquee": true,
      "useCrossfadeForAutoHide": true
    },
    "reduceTransparency": {
      "disableVisualEffectBlur": true,
      "useOpaqueThemeFallbackSurface": true,
      "widgetCardMinOpacity": 0.94
    },
    "increaseContrast": {
      "borderOuterWidthPt": 1.5,
      "borderOuterOpacityBoost": 0.35,
      "focusRingWidthPt": 2.5,
      "secondaryTextUsePrimaryColor": true
    }
  }
}
