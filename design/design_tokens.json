{
  "meta": {
    "product": "Panopticon",
    "schemaVersion": 1,
    "direction": "Native Glass Tactile",
    "minimumMacOS": "13.0",
    "consumers": [
      "AppKit panel",
      "SwiftUI settings and popovers"
    ]
  },
  "geometry": {
    "iconSize": {
      "min": 28,
      "default": 36,
      "max": 60,
      "step": 1,
      "unit": "pt"
    },
    "iconSpacing": {
      "min": 4,
      "default": 8,
      "max": 24,
      "step": 1,
      "unit": "pt"
    },
    "cornerRadius": {
      "min": 8,
      "default": 20,
      "max": 30,
      "step": 1,
      "unit": "pt"
    },
    "bottomOffset": {
      "min": 0,
      "default": 4,
      "max": 160,
      "step": 1,
      "unit": "pt"
    },
    "magnification": {
      "min": 1.0,
      "default": 1.35,
      "max": 1.8,
      "step": 0.05
    },
    "hoverLift": {
      "min": 0,
      "default": 7,
      "max": 16,
      "step": 1,
      "unit": "pt"
    },
    "shellOpacity": {
      "min": 0.0,
      "default": 0.1,
      "max": 0.65,
      "step": 0.01
    },
    "widgetWidth": {
      "min": 130,
      "default": 158,
      "max": 250,
      "step": 2,
      "unit": "pt"
    },
    "widgetOpacity": {
      "min": 0.08,
      "default": 0.28,
      "max": 0.7,
      "step": 0.01
    },
    "barHorizontalPadding": 12,
    "barVerticalPadding": 8,
    "screenEdgeMargin": 16,
    "autoHideTriggerThickness": 4,
    "spaceSwitcherButtonSize": 28,
    "spaceSwitcherMaxVisibleButtons": 3,
    "separatorThickness": 1,
    "separatorLengthRatio": 0.58,
    "runningIndicatorDotSize": 4,
    "runningIndicatorDashWidth": 10,
    "runningIndicatorDashHeight": 3,
    "badgeMinDiameter": 16,
    "badgeHorizontalPadding": 5,
    "settingsWindowMinSize": {
      "width": 780,
      "height": 540
    },
    "settingsWindowDefaultSize": {
      "width": 880,
      "height": 620
    },
    "settingsSidebarWidth": 200,
    "livePreviewHeaderHeight": 84,
    "popovers": {
      "calendar": {
        "width": 320,
        "height": 380,
        "cornerRadius": 16,
        "padding": 14
      },
      "music": {
        "width": 300,
        "height": 240,
        "cornerRadius": 16,
        "padding": 14
      },
      "timer": {
        "width": 260,
        "height": 210,
        "cornerRadius": 16,
        "padding": 14
      },
      "folderStack": {
        "width": 360,
        "height": 420,
        "cornerRadius": 16,
        "padding": 14
      },
      "quickLauncher": {
        "width": 560,
        "height": 380,
        "cornerRadius": 18,
        "padding": 12
      },
      "onboarding": {
        "width": 640,
        "height": 460,
        "cornerRadius": 18,
        "padding": 24
      }
    }
  },
  "typography": {
    "fontFamily": {
      "ui": "SF Pro Text, -apple-system",
      "display": "SF Pro Display, -apple-system",
      "rounded": "SF Pro Rounded, -apple-system",
      "mono": "SF Mono, ui-monospace"
    },
    "scale": {
      "windowTitle": {
        "size": 20,
        "weight": "semibold",
        "lineHeight": 26,
        "tracking": -0.2
      },
      "sectionHeader": {
        "size": 15,
        "weight": "semibold",
        "lineHeight": 20,
        "tracking": -0.1
      },
      "cardTitle": {
        "size": 13,
        "weight": "semibold",
        "lineHeight": 18,
        "tracking": 0.0
      },
      "body": {
        "size": 13,
        "weight": "regular",
        "lineHeight": 18,
        "tracking": 0.0
      },
      "bodyMedium": {
        "size": 13,
        "weight": "medium",
        "lineHeight": 18,
        "tracking": 0.0
      },
      "secondary": {
        "size": 12,
        "weight": "regular",
        "lineHeight": 16,
        "tracking": 0.0
      },
      "caption": {
        "size": 11,
        "weight": "medium",
        "lineHeight": 14,
        "tracking": 0.1
      },
      "badgeCount": {
        "size": 10,
        "weight": "bold",
        "lineHeight": 12,
        "tracking": 0.0,
        "monospacedDigits": true
      },
      "widgetPrimary": {
        "size": 14,
        "weight": "semibold",
        "lineHeight": 17,
        "tracking": -0.1,
        "monospacedDigits": true
      },
      "widgetSecondary": {
        "size": 11,
        "weight": "medium",
        "lineHeight": 14,
        "tracking": 0.0
      },
      "launcherInput": {
        "size": 17,
        "weight": "regular",
        "lineHeight": 22,
        "tracking": -0.1
      }
    },
    "hardFloorPt": 10
  },
